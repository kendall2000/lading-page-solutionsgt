APP_NAME="Solutions GT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=31.220.77.136
DB_PORT=3306
DB_DATABASE=solutionsgt
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=America/Guatemala
SESSION_SECURE_COOKIE=false

# Imágenes y PDFs del sitio en Contabo Object Storage: bucket propio «<id>:lading-page-solutionsgt».
CONTABO_KEY=
CONTABO_SECRET=
CONTABO_REGION=US-central
CONTABO_BUCKET=
CONTABO_ENDPOINT=https://usc1.contabostorage.com
CONTABO_CARPETA=

# Usuario inicial del panel (solo lo usa db:seed si no hay usuarios).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Tiempo real del chat (Laravel Reverb, contenedor solutionsgt-reverb).
# Llaves: inventadas por ti (id numérico, key y secret aleatorios). El secret nunca llega al navegador.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Cómo el sitio le envía los eventos a Reverb (red interna de Docker).
REVERB_HOST=solutionsgt-reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Cómo se conecta el navegador (IP o dominio público y puerto expuesto en docker-compose).
REVERB_PUBLICO_HOST=156.67.29.18
REVERB_PUBLICO_PORT=8098
REVERB_PUBLICO_SCHEME=http
# Dominios que pueden conectarse (separados por coma); * = cualquiera.
REVERB_ORIGENES=*
